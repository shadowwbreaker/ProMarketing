# ProMarketing — BETA deployment (D-025): everything real except money.
# Copy to .env.prod on the server, fill the blanks, start with infra/docker-compose.prod.yml (see docs/BETA.md).

BETA_MODE=true
PAYMENT_PROVIDER=mock                 # required by BETA_MODE: payments are simulated, nothing is charged
SOCIAL_PROVIDER_MODE=official         # real statistics only
YOUTUBE_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

DJANGO_SECRET_KEY=                    # >= 40 random chars
FIELD_ENCRYPTION_KEY=                 # Fernet key
SITE_DOMAIN=beta.example.ru
API_DOMAIN=api.beta.example.ru
DJANGO_ALLOWED_HOSTS=api.beta.example.ru
CSRF_TRUSTED_ORIGINS=https://beta.example.ru
CORS_ALLOWED_ORIGINS=https://beta.example.ru
FRONTEND_URL=https://beta.example.ru
PUBLIC_API_URL=https://api.beta.example.ru/api/v1   # baked into the frontend build
SESSION_COOKIE_DOMAIN=.beta.example.ru
CSRF_COOKIE_DOMAIN=.beta.example.ru

POSTGRES_PASSWORD=
DATABASE_URL=postgres://promarketing:${POSTGRES_PASSWORD}@db:5432/promarketing
REDIS_URL=redis://redis:6379/0

# Files: any S3-compatible bucket (Yandex Object Storage, Selectel, VK Cloud)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email: SMTP is better; without it set DEV_AUTO_VERIFY_EMAIL=true (allowed only with BETA_MODE)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ProMarketing <no-reply@beta.example.ru>
DEV_AUTO_VERIFY_EMAIL=false
