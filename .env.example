# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://promarketing:promarketing@db:5432/promarketing
REDIS_URL=redis://redis:6379/0
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Business (D-013..D-016)
DEFAULT_CURRENCY=RUB
PLATFORM_FEE_BPS=500
PLATFORM_FEE_PAYER=seller
PAYOUT_HOLD_HOURS=48
STATS_REFRESH_INTERVAL_HOURS=24
PLATFORM_TIKTOK_ENABLED=true
PLATFORM_INSTAGRAM_ENABLED=false
PLATFORM_YOUTUBE_ENABLED=true
YOUTUBE_DERIVED_METRICS_APPROVED=false

# Social providers: fake (dev only) | official
# auto: real API for a platform as soon as its keys below are set, demo numbers otherwise
SOCIAL_PROVIDER_MODE=auto
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Payments: mock (dev only) until provider is chosen (Q-03)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_WEBHOOK_SECRET=change-me

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# dev only: new accounts are confirmed immediately (forbidden in production)
DEV_AUTO_VERIFY_EMAIL=true
DEFAULT_FROM_EMAIL=no-reply@promarketing.local

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
